# =============================================================================
# NUMU API - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values

# Environment
DEBUG=true
ENVIRONMENT=development  # development, staging, production
APP_NAME=NUMU API
APP_VERSION=0.1.0

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=numu

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT (RS256 asymmetric signing)
# Generate keys with: python scripts/generate_jwt_keys.py
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Session (for admin panel cookies)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET_KEY=your-32-char-minimum-secret-key-here

# Credential Encryption
# Used to encrypt merchant payment gateway credentials at rest (AES via Fernet)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# MUST be at least 32 characters
CREDENTIAL_ENCRYPTION_KEY=your-credential-encryption-key-minimum-32-chars

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:3030","http://localhost:8000"]

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_AUTH_REQUESTS_PER_MINUTE=5

# =============================================================================
# Shopify App Integration
# =============================================================================

# Shared secret between this API and the numu-payments-intelligence Shopify app.
# Must match NUMU_API_INTERNAL_KEY in numu-payments-intelligence/.env
NUMU_API_INTERNAL_KEY=your-internal-key-here

# =============================================================================
# Payment Gateways
# =============================================================================

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Tap Payments
TAP_SECRET_KEY=sk_test_your_tap_secret_key
TAP_PUBLISHABLE_KEY=pk_test_your_tap_publishable_key

# =============================================================================
# External Services
# =============================================================================

# Shippo
SHIPPO_API_KEY=shippo_test_your_shippo_api_key

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o

# Reverse geocoding for the storefront checkout location picker.
# Two supported deployments:
#   1. Self-hosted Nominatim (recommended for prod):
#        NOMINATIM_URL=http://nominatim:8080
#        LOCATIONIQ_KEY=          # leave unset
#      Bring the nominatim service up from docker-compose.yml —
#      first import takes ~30min for the Egypt OSM extract.
#   2. LocationIQ free tier (bootstrap / low volume):
#        NOMINATIM_URL=https://us1.locationiq.com/v1
#        LOCATIONIQ_KEY=pk.your_free_locationiq_key
#      Sign up at https://locationiq.com/register — 5k req/day free.
# Leave both empty to disable the feature; checkout falls back to manual entry.
NOMINATIM_URL=
LOCATIONIQ_KEY=

# Resend Email
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM_ADDRESS=noreply@numu.com
EMAIL_FROM_NAME=NUMU

# MinIO / S3-compatible Object Storage
# For local dev with MinIO: S3_ENDPOINT_URL=http://localhost:9000
# For production with R2: S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=numu
S3_PUBLIC_URL=http://localhost:9000/numu
S3_REGION=us-east-1

# Database Backups
R2_BACKUP_BUCKET_NAME=numu-db-backups
BACKUP_RETENTION_DAYS=30

# =============================================================================
# Egyptian Market Integrations
# =============================================================================

# Paymob (Egyptian Payment Gateway)
PAYMOB_API_KEY=your_paymob_api_key
PAYMOB_INTEGRATION_ID=your_card_integration_id
PAYMOB_IFRAME_ID=your_iframe_id
PAYMOB_HMAC_SECRET=your_hmac_secret
PAYMOB_WALLET_INTEGRATION_ID=your_wallet_integration_id

# Platform InstaPay (merchant → NUMU: wallet top-ups + subscription payments)
# IPA unset → manual InstaPay flows return 503. OCR provider unset →
# every receipt goes to admin review (safe degraded mode).
PLATFORM_INSTAPAY_IPA=
PLATFORM_INSTAPAY_DISPLAY_NAME=
PLATFORM_INSTAPAY_OCR_PROVIDER=google_vision
GOOGLE_VISION_API_KEY=

# Fawry (Retail Pay Points)
FAWRY_MERCHANT_CODE=your_merchant_code
FAWRY_SECURITY_KEY=your_security_key
FAWRY_BASE_URL=https://atfawry.fawrystaging.com

# Bosta Shipping (Egyptian Courier)
BOSTA_API_KEY=your_bosta_api_key
BOSTA_BUSINESS_ID=your_business_id
BOSTA_BASE_URL=https://app.bosta.co/api/v2
BOSTA_WEBHOOK_SECRET=your_webhook_secret

# Cash on Delivery
COD_ENABLED=true
COD_FEE_PERCENTAGE=0.0
COD_FEE_FLAT=0
COD_MAX_AMOUNT=1000000
COD_MIN_AMOUNT=0

# WhatsApp Business API
# backend-030 — all keys required for platform-managed mode to send.
# For BYO (merchant-supplied WABA), only WHATSAPP_API_VERSION + META_APP_ID
# matter; the merchant's own access_token / phone_number_id / waba_id /
# app_secret get encrypted and stored in service_credentials.
WHATSAPP_ACCESS_TOKEN=your_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_verify_token
WHATSAPP_APP_SECRET=your_app_secret
WHATSAPP_ENABLED=false
# Meta Graph API version used by WhatsAppClient (see whatsapp_client.py L25).
WHATSAPP_BUSINESS_API_VERSION=v21.0
# Meta App ID — used at app boot to subscribe the platform app to the
# message_template_status_update webhook field on the platform WABA
# (FR-028 / T093). Also used by the existing embedded-signup flow.
META_APP_ID=your_meta_app_id

# Egyptian Tax Authority (ETA) E-Invoicing
ETA_CLIENT_ID=your_client_id
ETA_CLIENT_SECRET=your_client_secret
ETA_BASE_URL=https://api.invoicing.eta.gov.eg/api/v1
ETA_TOKEN_URL=https://id.eta.gov.eg/connect/token
ETA_ACTIVITY_CODE=4649
ETA_ENABLED=false

# =============================================================================
# Observability (Sentry, Structured Logging)
# =============================================================================

# Sentry - Error tracking and performance monitoring
# Get your DSN from https://sentry.io -> Project Settings -> Client Keys
# Leave empty to disable Sentry
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1
SENTRY_SEND_DEFAULT_PII=false

# Structured Logging
# LOG_LEVEL: DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_FORMAT: "json" for production, "console" for development
LOG_LEVEL=INFO
LOG_FORMAT=console

# =============================================================================
# NUMU Agent (merchant copilot)
# =============================================================================
# Pluggable LLM provider via an OpenAI-compatible client. Default is Groq's
# free/low-cost Llama 3.3 70B; swap provider/model by config alone (FR-012).
AGENT_ENABLED=true
AGENT_LLM_BASE_URL=https://api.groq.com/openai/v1
AGENT_LLM_API_KEY=
AGENT_LLM_MODEL=llama-3.3-70b-versatile
# Optional cheaper model for trivial read-only chat (router); leave blank to disable.
AGENT_LLM_MODEL_CHEAP=
AGENT_LLM_TEMPERATURE=0.2
AGENT_MAX_TOOL_ITERATIONS=5
AGENT_REQUEST_TIMEOUT_SECONDS=30
AGENT_RATE_LIMIT_MAX_RETRIES=3
AGENT_RATE_LIMIT_BACKOFF_SECONDS=2.0
# NUMU-knowledge RAG embeddings. Leave AGENT_EMBED_URL blank to use the local
# deterministic fallback embedder (dev). Production: point at an e5 embeddings server.
AGENT_EMBED_URL=
AGENT_EMBED_API_KEY=
AGENT_EMBED_MODEL=intfloat/multilingual-e5-large
AGENT_EMBED_DIM=1024
AGENT_KNOWLEDGE_TOP_K=5
# Knowledge base (spec 002). Coverage flags areas with no published article or
# stale beyond this window. pgvector is soft-added: retrieval falls back to the
# JSONB scan when the extension isn't present, so nothing breaks.
AGENT_KNOWLEDGE_STALENESS_DAYS=90
# Developer docs ingested into Layer A (theme/SDK/CLI/API topics).
AGENT_DOCS_INGEST_BASE_URL=https://docs.numueg.app
# Shared secret n8n uses to upsert shared (Layer A) NUMU knowledge.
AGENT_KNOWLEDGE_UPSERT_SECRET=
# n8n orchestration lane (heavy/async work). Allow-listed workflows only.
AGENT_N8N_BASE_URL=https://n8n.numueg.app
AGENT_N8N_WEBHOOK_SECRET=
AGENT_N8N_ALLOWED_WORKFLOWS=["ping","knowledge_ingest_docs","knowledge_refresh","tenant_layerb_reindex"]

# =============================================================================
# Localization
# =============================================================================
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=["en", "ar"]

# =============================================================================
# Storefront ISR Revalidation (Step 12)
# =============================================================================
# Shared secret between NUMU-api and numu-egyptian-bazaar. The backend
# POSTs to ${NUMU_STOREFRONT_BASE_URL with {subdomain} interpolated}/api/revalidate
# with this token in the `x-revalidation-secret` header whenever a
# product / category / theme mutation lands; the storefront flushes the
# matching ISR fetch-cache entries on-demand.
#
# Set the SAME value here and in numu-egyptian-bazaar/.env. Token mismatch
# returns 401 from the storefront → the backend logs a warning, request
# continues, the 60s ISR `revalidate` window is the safety net.
#
# Rotate quarterly. Always rotate in both repos in one push.
REVALIDATION_SECRET=

# Template for the storefront's per-store hostname. `{subdomain}` is
# substituted at call time from `store.subdomain`. Internal hostname is
# fine for production (saves a CF round-trip); the public hostname works
# for staging.
NUMU_STOREFRONT_BASE_URL=https://{subdomain}.numueg.app

# ─── Google Search Console (per-store sitemap submission) ────────────────────
# Every storefront is its own host and ships a valid /sitemap.xml, but Google
# never sees a sitemap it wasn't told about — a live, fully-indexable store page
# reads as "URL is unknown to Google" until its host's sitemap is submitted.
# IndexNow does NOT cover this: Google ignores IndexNow entirely.
#
# Leave blank on dev/test/stage — those hosts aren't verified, and the module is
# inert (every call a logged no-op) when the credentials var is empty.
#
# Setup, in this order — steps 1 and 3 are the ones that actually gate it:
#   1. Search Console → Add property → *Domain* → `numueg.app`, verify with the
#      DNS TXT record on Cloudflare. It MUST be a Domain property: a URL-prefix
#      property for https://numueg.app/ excludes subdomains, so every per-store
#      sitemap submission would 403 as "outside the property".
#   2. Google Cloud console → create a service account → Keys → Add key (JSON),
#      and enable the "Google Search Console API" on that project.
#   3. Search Console → Settings → Users and permissions → add the service
#      account's `client_email` (the ...@....iam.gserviceaccount.com address
#      from the JSON) with the **Owner** role. Full/Restricted cannot submit
#      sitemaps — the API returns 403.
#   4. Paste the key below. Base64 is accepted and preferred: the raw JSON has
#      embedded newlines in `private_key` that .env parsing mangles.
#         base64 -w0 service-account.json
GOOGLE_SEARCH_CONSOLE_CREDENTIALS_JSON=
# Property identifier. Domain property = `sc-domain:numueg.app` (the default).
GOOGLE_SEARCH_CONSOLE_SITE_URL=sc-domain:numueg.app

# =============================================================================
# Shopify companion app (numu-payments-intelligence)
# =============================================================================
# Shared secret for the X-Internal-Key header on /api/v1/shopify/* — must
# match NUMU_API_INTERNAL_KEY in the Shopify app's .env.
SHOPIFY_INTERNAL_KEY=
# Public base URL of the Shopify app. Required in production for the
# verification-overage billing relay (POST {url}/api/billing/usage-record).
SHOPIFY_APP_URL=https://shopify.numueg.app
# Base URL of the buyer-facing payment page (the app's /p/{session_id}
# route). Optional — defaults to "{SHOPIFY_APP_URL}/p".
SHOPIFY_PAYMENT_PAGE_URL=
